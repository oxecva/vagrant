# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  # Опис: Визначає базовий образ (офіційний бокс Ubuntu 20.04 LTS), який Vagrant завантажує з офіційного каталогу.
  config.vm.box = "ubuntu/focal64"

  # Опис: Налаштування параметрів віртуальної машини для провайдера VirtualBox (виділення апаратних ресурсів хоста).
  config.vm.provider "virtualbox" do |vb|
    # Опис: Виділяє 2 гігабайти оперативної пам'яті (2048 МБ) для забезпечення стабільної роботи ОС усередині середовища.
    vb.memory = "2048"
    # Опис: Призначає 2 віртуальні процесори (CPU) для прискорення виконання команд та обробки завдань.
    vb.cpus = 2
  end

  # Опис: Налаштування локальної мережі; виділяє віртуальній машині статичну IP-адресу для зручного доступу з комп'ютера.
  config.vm.network "private_network", ip: "192.168.56.10"

  # Опис: Синхронізація папок; автоматично зв'язує локальну папку проєкту з комп'ютера та директорію /vagrant всередині віртуальної машини.
  config.vm.synced_folder ".", "/vagrant"

  # Опис: Блок автоматичного налаштування (Provisioning) за допомогою shell-скрипта при першому запуску віртуальної машини.
  config.vm.provision "shell", inline: <<-SHELL
    # Опис: Оновлення списків пакетів операційної системи до актуального стану з репозиторіїв Ubuntu.
    apt-get update -y
    # Опис: Автоматичне встановлення системи контролю версій Git всередині віртуального середовища.
    apt-get install -y git
  SHELL
end
